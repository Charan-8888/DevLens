  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.ffmpegkit-maintained</groupId>
  <artifactId>llama-android</artifactId>
  <version>0.1.1</version>
  <packaging>aar</packaging>
  <name>llama-android</name>
  <description>Prebuilt llama.cpp AAR for Android — on-device LLM inference (chat, completion, embeddings), no NDK, no cloud, no API key. GGUF models, arm64-v8a, API 24+.</description>
  <url>https://github.com/ffmpegkit-maintained/llama-android</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/ffmpegkit-maintained/llama-android/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>jokobee</id>
      <name>Jokobee</name>
      <email>contact@jokobee.com</email>
      <url>https://www.jokobee.com</url>
      <organization>Jokobee</organization>
      <organizationUrl>https://www.jokobee.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ffmpegkit-maintained/llama-android.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ffmpegkit-maintained/llama-android.git</developerConnection>
    <url>https://github.com/ffmpegkit-maintained/llama-android</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.0.21</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-android</artifactId>
      <version>1.9.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core-ktx</artifactId>
      <version>1.13.1</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
